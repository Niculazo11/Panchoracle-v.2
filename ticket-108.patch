+
+describe("Auditoría · rate limit de unirse a un salón", () => {
+  let mongod, server;
+  before(async () => {
+    mongod = await MongoMemoryServer.create({ binary: { version: "7.0.0" } });
+    process.env.MONGODB_URI = mongod.getUri();
