# Copia este archivo a ".env" y completa los valores. NUNCA subas ".env" a GitHub.

# Cadena de conexión a MongoDB Atlas (o a un Mongo local para pruebas).
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/panchoracle?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017/panchoracle
MONGODB_URI=

# Origen(es) de Vercel permitidos por CORS, separados por coma, sin "/" al final.
# Ejemplo: https://tu-proyecto.vercel.app
# (GitHub Pages y localhost ya están permitidos en el código.)
# OPCIONAL. Front y API comparten dominio en Vercel, así que normalmente va vacío.
# Solo si añades un dominio propio distinto al de Vercel (separados por coma, sin "/" final).
ALLOWED_ORIGINS=
PORT=3000

# Secreto para firmar los JWT. Genera uno largo y aleatorio; NUNCA lo subas.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Código que debe ingresar un profesor al registrarse (acordar el nombre con Karol).
TEACHER_CODE=